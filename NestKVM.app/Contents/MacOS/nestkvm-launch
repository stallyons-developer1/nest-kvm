#!/bin/bash
# Launched by double-clicking NestKVM.app — no Terminal window appears.
# The .app lives inside the nest-kvm project folder; find that folder.
HERE="$(cd "$(dirname "$0")" && pwd)"      # .../NestKVM.app/Contents/MacOS
DIR="$(cd "$HERE/../../.." && pwd)"         # .../nest-kvm
cd "$DIR" || exit 1

if [ ! -d .venv ]; then
  python3 -m venv .venv
  ./.venv/bin/pip install -r requirements.txt
fi

exec ./.venv/bin/python -m nestkvm gui
